# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of browser origins allowed to call the API with credentials
CLIENT_URL=http://localhost:3000

# ---- MongoDB ----
# Omit or leave unreachable to fall back to an in-memory MongoDB for local testing
MONGO_URI=mongodb://mongodb:27017/lm-verify

# ---- Auth ----
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-must-differ
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d
REFRESH_EXPIRY_MS=604800000
BCRYPT_ROUNDS=12

# Send the refresh cookie only over HTTPS (forced on when NODE_ENV=production)
COOKIE_SECURE=false

# Account lockout after repeated failed sign-ins
MAX_LOGIN_ATTEMPTS=5
LOCK_WINDOW_MS=900000

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Extraction mode --------------------------------------------------------
# gemini  the model reads the label and locates its regions. The OCR engines,
#         the millimetre measurement stages and the statutory rule engine are
#         DORMANT: this build extracts and reports, it does not adjudicate.
# legacy  restores the OCR + measurement pipeline and the rule engine.
# The dormant code is untouched, so switching is an environment change.
EXTRACTION_MODE=gemini

# ---- Vision service (OCR + measurement sidecar) ----
OCR_SERVICE_URL=http://vision:8001
VISION_TIMEOUT_MS=30000

# Which OCR engine the sidecar loads: paddleocr | easyocr
# With neither installed it falls back to a deterministic stub and flags every
# reading for officer review.
OCR_ENGINE=paddleocr

# --- Optional VLM pass -------------------------------------------------------
# Reads what regex cannot: the manufacturer attribution, the generic name, the
# package type (which sets the curved / moulded flags), and the nutrition table.
# Leave VLM_ENABLED=true and those heads route to officer review instead.
#
# NEVER put a key in source or in docker-compose.yml. This file is committed;
# the real .env is gitignored. A key committed once stays in git history.
VLM_ENABLED=true
VLM_PROVIDER=google            # anthropic | google | openai
VLM_MODEL=gemini-2.5-flash      # blank = provider default
VLM_API_KEY=                    # paste the key here, in .env only

# Backup keys, tried in order when the primary cannot be used -- revoked,
# expired, or out of quota. A key that is merely busy is retried instead, so a
# transient outage never burns the spare.
VLM_API_KEY_2=
VLM_API_KEY_3=
# Or a comma-separated list for more than three.
VLM_API_KEYS=

# When every key is exhausted, read the label with the local OCR engine rather
# than losing the capture. The reading is worse and is flagged as such on the
# result, in the report and on the inspection record.
EXTRACTION_FALLBACK_ENABLED=true
EXTRACTION_FALLBACK_ENGINE=easyocr
VLM_TIMEOUT_S=30

# ---- Upload ----
UPLOAD_MAX_SIZE=20MB

# Frontend origin OAuth redirects land back on
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Google sign-in (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application). Leave blank to hide the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Comma-separated list, e.g. gov.in,nic.in. Empty = any Google account.
GOOGLE_ALLOWED_DOMAINS=

# Public self-registration
SIGNUP_ENABLED=true
SELF_SIGNUP_ROLE=field_inspector
